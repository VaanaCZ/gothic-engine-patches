// While walking in very shallow water, water footsteps are
// are not played, even if they are defined in sfxinst.d.
// This patch adds a check for shallow water that lets
// water footsteps play.
// Created by Vaana

#engine [G1]
    #patch [Water footsteps fix]
        #assembler [0x00561C8E]
            mov     ecx, [edi+54h]
            mov     ecx, [ecx+0FCh]     ; m_poCollisionObject
            test    ecx, ecx
            jz      return
            mov     ecx, [ecx+0D4h]     ; m_poWaterPoly
            test    ecx, ecx
            jz      return
            mov     eax, ecx
         return:
            orgcode
        #/assembler
    #/patch
#/engine

