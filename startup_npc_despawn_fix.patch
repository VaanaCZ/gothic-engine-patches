// Fixes a bug where routine-less NPCs close to 0,0,0 will not spawn
// when going through a changelevel trigger, which advances time.
// The main example of this is sheep in the Old Camp castle in Gothic II.
// Created by Vaana

#engine [G1]
    #patch [Wld_SetTime in startup fix]
        #assembler [0x0063A965]
            xor     ebx, ebx
            cmp     [esi+24h], ebx
            jz      return
            pop     edi
            pop     esi
            pop     ebx
            add     esp, 8
            ret     0Ch
        return:
            orgcode
        #/assembler
    #/patch
#/engine

